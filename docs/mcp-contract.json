          "visibility": [
            "app"
          ]
        }
      }
    },
    {
      "name": "ui_save",
      "description": "App only: save a credential. Omitted values preserve existing secrets of the same kind.",
      "inputSchema": {
        "properties": {
          "record": {
            "additionalProperties": true,
            "title": "Record",
            "type": "object"
          }
        },
        "required": [
          "record"
        ],
        "title": "ui_saveArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
