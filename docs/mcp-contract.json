{
  "version": "0.1.0",
  "transport": "stdio",
  "tools": [
    {
      "name": "aksk.open",
      "title": "AKSK Manager",
      "description": "Open the AKSK Manager credential management app.",
      "inputSchema": {
        "properties": {},
        "title": "open_managerArguments",
        "type": "object"
      },
      "icons": [
        {
          "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='8' y='27' width='48' height='30' rx='8' fill='%232e7164'/%3E%3Cpath d='M20 27V19a12 12 0 0 1 24 0v8' fill='none' stroke='%232e7164' stroke-width='5'/%3E%3C/svg%3E",
          "mimeType": "image/svg+xml"
        }
      ],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://aksk-manager/vault"
        },
        "openai/ui": {
          "entrypoints": [
            {
              "type": "thread"
            }
          ]
        }
      }
    },
    {
      "name": "list_secrets",
      "description": "Search all active metadata including notes, kind, field names, IDs and dates.\n\n    Whitespace-separated terms match across fields, ignoring case, accents and width.\n    Credential and database connection values are not searched or returned.\n    ",
      "inputSchema": {
        "properties": {
          "query": {
            "default": "",
            "title": "Query",
            "type": "string"
          }
        },
        "title": "list_secretsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_secret_metadata",
      "description": "Get a credential's metadata, revision and available field names without revealing secrets.",
      "inputSchema": {
        "properties": {
          "secret_id": {
            "title": "Secret Id",
            "type": "string"
          }
        },
        "required": [
          "secret_id"
        ],
        "title": "get_secret_metadataArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "update_secret",
      "description": "Update one existing credential in place for a user-authorized task; returns metadata only.\n\n    Read metadata first and pass its revision. changes edits non-secret metadata; omitted/null\n    changes preserve it. Never put credentials or connection values in metadata.\n    field_refs maps destination fields to existing {secret_id, revision, field, json_path?}.\n    A json_path is an ordered list of object keys selecting a string inside a JSON credential;\n    resolution occurs only in the native helper. No plaintext values are accepted or returned.\n    Same-kind edits preserve unmentioned values. Kind changes require all required fields via\n    references and discard old-kind fields. remove_fields clears optional fields explicitly.\n    No creation or deletion. On conflict/unknown outcome, read metadata before any retry.\n    ",
      "inputSchema": {
        "$defs": {
          "CredentialReference": {
            "additionalProperties": false,
            "properties": {
              "secret_id": {
                "title": "Secret Id",
                "type": "string"
              },
              "revision": {
                "title": "Revision",
                "type": "string"
              },
              "field": {
                "enum": [
                  "access_key",
                  "secret_key",
                  "session_token",
                  "token",
                  "engine",
                  "host",
                  "port",
                  "database",
                  "username",
                  "password",
                  "ssl_mode"
                ],
                "title": "Field",
                "type": "string"
              },
              "json_path": {
                "items": {
                  "type": "string"
                },
                "maxItems": 16,
                "title": "Json Path",
                "type": "array"
              }
            },
            "required": [
              "secret_id",
              "revision",
              "field"
            ],
            "title": "CredentialReference",
            "type": "object"
          },
          "MetadataChanges": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Name"
              },
              "kind": {
                "anyOf": [
                  {
                    "enum": [
                      "aksk",
                      "token",
                      "database"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Kind"
              },
              "provider": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Provider"
              },
              "account": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Account"
              },
              "environment": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Environment"
              },
              "tags": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Tags"
              },
              "notes": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Notes"
              }
            },
            "title": "MetadataChanges",
            "type": "object"
          }
        },
        "properties": {
          "secret_id": {
            "title": "Secret Id",
            "type": "string"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "string"
          },
          "changes": {
            "anyOf": [
              {
                "$ref": "#/$defs/MetadataChanges"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "field_refs": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/$defs/CredentialReference"
                },
                "propertyNames": {
                  "enum": [
                    "access_key",
                    "secret_key",
                    "session_token",
                    "token",
                    "engine",
                    "host",
                    "port",
                    "database",
                    "username",
                    "password",
                    "ssl_mode"
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field Refs"
          },
          "remove_fields": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "access_key",
                    "secret_key",
                    "session_token",
                    "token",
                    "engine",
                    "host",
                    "port",
                    "database",
                    "username",
                    "password",
                    "ssl_mode"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Remove Fields"
          }
        },
        "required": [
          "secret_id",
          "expected_revision"
        ],
        "title": "update_secretArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "run_with_secrets",
      "description": "Run a user-authorized command with credentials injected locally into its environment.\n\n    bindings maps an environment variable name to {secret_id, field}. Fields are access_key,\n    secret_key, session_token, token, or database fields engine, host, port, database,\n    username, password, ssl_mode. Bind only fields listed in metadata. Use an absolute cwd. argv is not shell-expanded;\n    explicitly invoke a shell only when needed. Returns a run id; poll get_run for output.\n    Never run commands intended to reveal or export credentials. This is not a security sandbox.\n    ",
      "inputSchema": {
        "properties": {
          "argv": {
            "items": {
              "type": "string"
            },
            "title": "Argv",
            "type": "array"
          },
          "cwd": {
            "title": "Cwd",
            "type": "string"
          },
          "bindings": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Bindings",
            "type": "object"
          },
          "timeout_seconds": {
            "default": 600,
            "title": "Timeout Seconds",
            "type": "number"
          }
        },
        "required": [
          "argv",
          "cwd",
          "bindings"
        ],
        "title": "run_with_secretsArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_run",
      "description": "Get the run's state and completed redacted output. Jobs belong to this MCP session.",
      "inputSchema": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "get_runArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "cancel_run",
      "description": "Cancel a running command and its process group.",
      "inputSchema": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "cancel_runArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "ui_status",
      "description": "App only: inspect helper and Keychain access, without claiming remote sync.",
      "inputSchema": {
        "properties": {},
        "title": "ui_statusArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "_meta": {
        "ui": {
          "visibility": [
            "app"
          ]
        }
      }
    },
    {
      "name": "ui_list",
      "description": "App only: search all fields locally, including passwords, keys and token values.\n\n    Returns metadata only via private app results; never returns matched credential values.\n    ",
      "inputSchema": {
        "properties": {
          "trash": {
            "default": false,
            "title": "Trash",
            "type": "boolean"
          },
          "query": {
            "default": "",
            "title": "Query",
            "type": "string"
          }
        },
        "title": "ui_listArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
