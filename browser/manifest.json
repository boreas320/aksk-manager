{
  "manifest_version": 3,
  "key": "",
  "name": "AKSK Manager",
  "version": "0.3.4",
  "description": "为当前网站填入选定账号的用户名、密码或验证码",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "fields.js",
        "click-fill.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
